# Database (Neon)
TWILIO_SERVICE_DATABASE_URL=postgresql://neondb_owner:xxx@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Key Service — resolves the PLATFORM Twilio credential (account SID + auth
# token). Stored under the "twilio" provider as a platform key whose decrypted
# value is JSON: {"accountSid":"ACxxxx","authToken":"xxxx"}. No env fallback.
KEY_SERVICE_URL=http://localhost:3005
KEY_SERVICE_API_KEY=your-key-service-api-key

# Twilio Phone Numbers (one per project)
TWILIO_MCPFACTORY_PHONE_NUMBER=+15551234567
TWILIO_PRESSBEAT_PHONE_NUMBER=+15559876543

# Authentication (service-to-service)
TWILIO_SERVICE_API_KEY=shared-secret-for-service-to-service-auth

# Runs Service (run tracking & cost management)
RUNS_SERVICE_URL=http://localhost:3006
RUNS_SERVICE_API_KEY=your-runs-service-api-key

# ── WhatsApp channel ─────────────────────────────────────────────────────────

# Chat Service — the agentic AI brain the WhatsApp adapter forwards to (same one
# the dashboard uses). chat-service owns the config (system prompt + tools),
# model resolution, and LLM cost. The config key ("whatsapp") is code-owned.
CHAT_SERVICE_URL=http://localhost:3010
CHAT_SERVICE_API_KEY=your-chat-service-api-key

# Client Service — phone→account resolve/provision (owns Clerk org + welcome credit)
CLIENT_SERVICE_URL=http://localhost:3007
CLIENT_SERVICE_API_KEY=your-client-service-api-key
# Optional: override the phone-provision path if client-service renames it.
# CLIENT_PHONE_PROVISION_PATH=/internal/phone-accounts

# Public URL of this service (Railway). Used to build the exact URL Twilio signs
# its inbound-webhook / status-callback requests with (base + route path).
TWILIO_SERVICE_PUBLIC_URL=https://twillio.distribute.you

# Note: the WhatsApp sender number, chat config key, webhook-validation flag, and
# WhatsApp cost name are now code-owned constants (see src/lib + src/routes).

# Server
PORT=3011
